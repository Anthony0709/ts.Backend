generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id String @id @default(cuid())

  nombre String @unique

  nombreComercial String?

  ruc String @unique

  email String? @unique

  telefono String?

  direccion String?

  ciudad String?

  pais String?

  sitioWeb String?

  activo Boolean @default(true)

  configuracion Configuracion?

  usuarios       Usuario[]
  roles          Rol[]
  sucursales     Sucursal[]
  clientes       Cliente[]
  proveedores    Proveedor[]
  categorias     Categoria[]
  marcas         Marca[]
  productos      Producto[]
  bodegas        Bodega[]
  compras        Compra[]
  ventas         Venta[]
  cotizaciones   Cotizacion[]
  ordenesCompra  OrdenCompra[]
  cuentasCobrar  CuentaCobrar[]
  cuentasPagar   CuentaPagar[]
  gastos         Gasto[]
  cajas          Caja[]
  transferencias Transferencia[]
  devoluciones   Devolucion[]
  auditorias     Auditoria[]
  suscripciones  Suscripcion[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([activo])
  @@index([ruc])
  @@index([createdAt])
}

model Rol {
  id String @id @default(cuid())

  codigo String?

  nombre String

  descripcion String?

  activo Boolean @default(true)

  empresaId String

  empresa Empresa @relation(fields: [empresaId], references: [id])

  usuarios Usuario[]

  permisos RolPermiso[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([activo])
  @@index([empresaId, activo])
  @@index([empresaId, createdAt])
}

model Usuario {
  id String @id @default(cuid())

  nombres   String
  apellidos String

  email String

  password String

  activo Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  rolId          String
  rol            Rol            @relation(fields: [rolId], references: [id])
  auditorias     Auditoria[]
  notificaciones Notificacion[]
  cajasAbiertas  Caja[]         @relation("UsuarioAperturaCaja")

  cajasCerradas Caja[] @relation("UsuarioCierreCaja")

  movimientosCaja MovimientoCaja[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, email])
  @@index([empresaId, activo])
  @@index([empresaId, rolId])
}

model Sucursal {
  id String @id @default(cuid())

  nombre String

  codigo String

  direccion String?

  telefono String?

  email String?

  ciudad String?

  estado Boolean @default(true)

  empresaId String

  empresa Empresa
    @relation(
      fields: [empresaId],
      references: [id],
      onDelete: Restrict
    )

  //=====================================================
  // BODEGA PRINCIPAL DE LA SUCURSAL
  //=====================================================

  bodegaPrincipalId String?

  bodegaPrincipal Bodega?
    @relation(
      "BodegaPrincipalSucursal",
      fields: [bodegaPrincipalId],
      references: [id]
    )

  //=====================================================
  // BODEGAS DE LA SUCURSAL
  //=====================================================

  bodegas Bodega[]
    @relation("BodegasSucursal")

  //=====================================================
  // CAJAS / PUNTOS DE VENTA
  //=====================================================

  cajas Caja[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])

  @@unique([empresaId, codigo])

  @@unique([bodegaPrincipalId])

  @@index([empresaId, estado])

  @@index([empresaId, createdAt])
}

enum TipoIdentificacion {
  CEDULA
  RUC
  PASAPORTE
  OTRO
}

enum TipoCliente {
  PERSONA

  EMPRESA
}

model Cliente {
  id String @id @default(cuid())

  nombre String

  apellido String

  tipoIdentificacion TipoIdentificacion

  identificacion String

  tipoCliente TipoCliente @default(PERSONA)

  razonSocial String?

  nombreComercial String?

  email String?

  telefono String?

  direccion String?

  limiteCredito Decimal? @db.Decimal(12, 2)

  diasCredito Int?

  observacion String?

  estado Boolean @default(true)

  empresaId String

  empresa Empresa @relation(fields: [empresaId], references: [id])

  ventas Venta[]

  cotizaciones Cotizacion[]

  cuentasCobrar CuentaCobrar[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, identificacion])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([nombre])
  @@index([apellido])
  @@index([identificacion])
  @@index([empresaId, createdAt])
}

model Proveedor {
  id String @id @default(cuid())

  nombreComercial String

  razonSocial String

  ruc String

  contacto String?

  cargoContacto String?

  email String?

  telefono String?

  celular String?

  direccion String?

  ciudad String?

  provincia String?

  pais String? @default("Ecuador")

  observaciones String?

  diasCredito Int @default(0)

  limiteCredito Decimal? @db.Decimal(12, 2)

  estado Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  compras Compra[]

  ordenesCompra OrdenCompra[]

  cuentasPagar CuentaPagar[]

  gastos Gasto[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, ruc])
  @@index([empresaId])
  @@index([nombreComercial])
  @@index([razonSocial])
  @@index([estado])
  @@index([empresaId, estado])
  @@index([empresaId, createdAt])
}

model Categoria {
  id String @id @default(cuid())

  nombre String

  descripcion String?

  codigo String?

  color String? @default("#2563EB")

  icono String?

  orden Int @default(0)

  estado Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  productos Producto[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([nombre])
  @@index([estado])
  @@index([empresaId, estado])
  @@index([empresaId, createdAt])
}

model Marca {
  id String @id @default(cuid())

  nombre String

  descripcion String?

  estado Boolean @default(true)

  empresaId String
  empresa   Empresa    @relation(fields: [empresaId], references: [id])
  productos Producto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, nombre])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, createdAt])
}

model Producto {
  id String @id @default(cuid())

  codigo String

  sku String

  codigoBarras String

  nombre String

  descripcion String?

  imagen String?

  precioCompra Decimal @db.Decimal(10, 2)

  precioVenta Decimal @db.Decimal(10, 2)

  stockMinimo Int @default(0)

  stockMaximo Int?

  estado Boolean @default(true)

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  marcaId String
  marca   Marca  @relation(fields: [marcaId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  /**
   * =====================================================
   * ==================== RELACIONES =======================
   * =====================================================
   */

  inventarios ProductoBodega[]

  movimientos MovimientoInventario[]

  comprasDetalle CompraDetalle[]

  ventasDetalle VentaDetalle[]

  cotizacionesDetalle CotizacionDetalle[]

  ordenesCompraDetalle OrdenCompraDetalle[]

  transferenciasDetalle TransferenciaDetalle[]

  devolucionesDetalle DevolucionDetalle[]

  /**
   * =====================================================
   * ===================== FECHAS ==========================
   * =====================================================
   */

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, codigo])
  @@unique([empresaId, sku])
  @@unique([empresaId, codigoBarras])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, categoriaId])
  @@index([empresaId, marcaId])
  @@index([empresaId, createdAt])
}

model Bodega {
  id String @id @default(cuid())

  nombre String

  codigo String

  direccion String?

  responsable String?

  telefono String?

  estado Boolean @default(true)

  //=====================================================
  // EMPRESA
  //=====================================================

  empresaId String

  empresa Empresa
    @relation(
      fields: [empresaId],
      references: [id]
    )

  //=====================================================
  // SUCURSAL
  //=====================================================

  sucursalId String?

  sucursal Sucursal?
    @relation(
      "BodegasSucursal",
      fields: [sucursalId],
      references: [id]
    )

  //=====================================================
  // BODEGA PRINCIPAL DE SUCURSAL
  //=====================================================

  sucursalPrincipal Sucursal?
    @relation("BodegaPrincipalSucursal")

  //=====================================================
  // INVENTARIO
  //=====================================================

  inventarios ProductoBodega[]

  movimientos MovimientoInventario[]

  //=====================================================
  // TRANSFERENCIAS
  //=====================================================

  transferenciasOrigen Transferencia[]
    @relation("BodegaOrigen")

  transferenciasDestino Transferencia[]
    @relation("BodegaDestino")

  //=====================================================
  // DEVOLUCIONES
  //=====================================================

  devoluciones Devolucion[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, codigo])

  @@index([empresaId])

  @@index([empresaId, estado])

  @@index([empresaId, sucursalId])

  @@index([empresaId, createdAt])
}

model ProductoBodega {
  id String @id @default(cuid())

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  bodegaId String
  bodega   Bodega @relation(fields: [bodegaId], references: [id])

  stock Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productoId, bodegaId])
  @@index([productoId])
  @@index([bodegaId])
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  TRANSFERENCIA
}

model MovimientoInventario {
  id String @id @default(cuid())

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  bodegaId String
  bodega   Bodega @relation(fields: [bodegaId], references: [id])

  tipo TipoMovimiento

  cantidad Int

  stockAnterior Int

  stockNuevo Int

  observacion String?
  createdAt   DateTime @default(now())

  @@index([productoId, bodegaId, createdAt])
  @@index([bodegaId, createdAt])
}

model Compra {
  id String @id @default(cuid())

  numero String

  fecha DateTime @default(now())

  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  estado EstadoCompra @default(BORRADOR)

  observacion String?

  subtotal Decimal @db.Decimal(10, 2)

  impuesto Decimal @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  detalles     CompraDetalle[]
  cuentaPagar  CuentaPagar?
  devoluciones Devolucion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, proveedorId])
  @@index([empresaId, createdAt])
}

model CompraDetalle {
  id String @id @default(cuid())

  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  costo Decimal @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  @@index([compraId])
  @@index([productoId])
}

enum EstadoCompra {
  BORRADOR

  APROBADA

  ANULADA
}

enum EstadoVenta {
  BORRADOR
  APROBADA
  ANULADA
}

model Venta {
  id String @id @default(cuid())

  numero String

  fecha DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  estado EstadoVenta @default(BORRADOR)

  observacion String?

  subtotal Decimal @db.Decimal(10, 2)

  impuesto Decimal @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  detalles        VentaDetalle[]
  cuentaCobrar    CuentaCobrar?
  devoluciones    Devolucion[]
  movimientosCaja MovimientoCaja[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, clienteId])
  @@index([empresaId, createdAt])
}

model VentaDetalle {
  id String @id @default(cuid())

  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  precio Decimal @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  @@index([ventaId])
  @@index([productoId])
}

enum EstadoCotizacion {
  BORRADOR
  APROBADA
  RECHAZADA
  CONVERTIDA
}

model Cotizacion {
  id String @id @default(cuid())

  numero String

  fecha DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  estado EstadoCotizacion @default(BORRADOR)

  observacion String?

  subtotal Decimal @db.Decimal(10, 2)

  impuesto Decimal @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  detalles CotizacionDetalle[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, clienteId])
  @@index([empresaId, createdAt])
}

model CotizacionDetalle {
  id String @id @default(cuid())

  cotizacionId String
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  precio Decimal @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  @@index([cotizacionId])
  @@index([productoId])
}

enum EstadoOrdenCompra {
  BORRADOR

  APROBADA

  CANCELADA

  CONVERTIDA
}

model OrdenCompra {
  id String @id @default(cuid())

  numero String

  fecha DateTime @default(now())

  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  estado EstadoOrdenCompra @default(BORRADOR)

  observacion String?

  subtotal Decimal @db.Decimal(10, 2)

  impuesto Decimal @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  detalles OrdenCompraDetalle[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, proveedorId])
  @@index([empresaId, createdAt])
}

model OrdenCompraDetalle {
  id String @id @default(cuid())

  ordenCompraId String
  ordenCompra   OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  costo Decimal @db.Decimal(10, 2)

  subtotal Decimal @db.Decimal(10, 2)

  @@index([ordenCompraId])
  @@index([productoId])
}

enum EstadoCaja {
  ABIERTA

  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO

  EGRESO

  AJUSTE

  VENTA

  DEVOLUCION

  GASTO
}

model Caja {
  id String @id @default(cuid())

  nombre String

  //=====================================================
  // EMPRESA
  //=====================================================

  empresaId String

  empresa Empresa
    @relation(
      fields: [empresaId],
      references: [id],
      onDelete: Restrict
    )

  //=====================================================
  // SUCURSAL
  //=====================================================

  sucursalId String

  sucursal Sucursal
    @relation(
      fields: [sucursalId],
      references: [id]
    )

  //=====================================================
  // SALDOS
  //=====================================================

  saldoInicial Decimal
    @db.Decimal(10, 2)

  saldoEsperado Decimal?
    @db.Decimal(10, 2)

  saldoContado Decimal?
    @db.Decimal(10, 2)

  saldoFinal Decimal?
    @db.Decimal(10, 2)

  diferencia Decimal?
    @db.Decimal(10, 2)

  //=====================================================
  // ESTADO
  //=====================================================

  estado EstadoCaja
    @default(CERRADA)

  fechaApertura DateTime?

  fechaCierre DateTime?

  observacion String?

  //=====================================================
  // USUARIO APERTURA
  //=====================================================

  usuarioAperturaId String?

  usuarioApertura Usuario?
    @relation(
      "UsuarioAperturaCaja",
      fields: [usuarioAperturaId],
      references: [id]
    )

  //=====================================================
  // USUARIO CIERRE
  //=====================================================

  usuarioCierreId String?

  usuarioCierre Usuario?
    @relation(
      "UsuarioCierreCaja",
      fields: [usuarioCierreId],
      references: [id]
    )

  //=====================================================
  // MOVIMIENTOS
  //=====================================================

  movimientos MovimientoCaja[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([empresaId])

  @@index([empresaId, sucursalId])

  @@index([empresaId, estado])

  @@index([empresaId, createdAt])
}

model MovimientoCaja {
  id String @id @default(cuid())

  cajaId String

  caja Caja               @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  tipo TipoMovimientoCaja

  descripcion String

  monto Decimal @db.Decimal(10, 2)

  metodoPago MetodoPago?

  referencia String?

  ventaId String?

  venta Venta? @relation(fields: [ventaId], references: [id])

  usuarioId String?

  usuario   Usuario? @relation(fields: [usuarioId], references: [id])
  createdAt DateTime @default(now())

  @@index([cajaId, createdAt])
  @@index([usuarioId, createdAt])
  @@index([ventaId])
}

enum MetodoPago {
  EFECTIVO

  TARJETA

  TRANSFERENCIA

  CHEQUE

  CREDITO

  OTRO
}

enum EstadoCuentaCobrar {
  PENDIENTE

  PARCIAL

  PAGADA

  VENCIDA
}

model CuentaCobrar {
  id String @id @default(cuid())

  numero String

  fecha DateTime @default(now())

  fechaVencimiento DateTime?

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  ventaId String @unique
  venta   Venta  @relation(fields: [ventaId], references: [id])

  estado EstadoCuentaCobrar @default(PENDIENTE)

  total Decimal @db.Decimal(10, 2)

  saldo Decimal @db.Decimal(10, 2)

  observacion String?

  abonos AbonoCuentaCobrar[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, clienteId])
  @@index([empresaId, fechaVencimiento])
}

model AbonoCuentaCobrar {
  id String @id @default(cuid())

  cuentaCobrarId String

  cuentaCobrar CuentaCobrar @relation(fields: [cuentaCobrarId], references: [id], onDelete: Cascade)

  fecha DateTime @default(now())

  monto Decimal @db.Decimal(10, 2)

  metodoPago MetodoPago?

  referencia String?

  observacion String?

  @@index([cuentaCobrarId, fecha])
}

enum EstadoCuentaPagar {
  PENDIENTE

  PARCIAL

  PAGADA

  VENCIDA
}

model CuentaPagar {
  id String @id @default(cuid())

  numero String

  fecha DateTime @default(now())

  fechaVencimiento DateTime?

  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  compraId String @unique
  compra   Compra @relation(fields: [compraId], references: [id])

  estado EstadoCuentaPagar @default(PENDIENTE)

  total Decimal @db.Decimal(10, 2)

  saldo Decimal @db.Decimal(10, 2)

  observacion String?

  pagos AbonoCuentaPagar[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, proveedorId])
  @@index([empresaId, fechaVencimiento])
}

model AbonoCuentaPagar {
  id String @id @default(cuid())

  cuentaPagarId String

  cuentaPagar CuentaPagar @relation(fields: [cuentaPagarId], references: [id], onDelete: Cascade)

  fecha DateTime @default(now())

  monto Decimal @db.Decimal(10, 2)

  metodoPago MetodoPago?

  referencia String?

  observacion String?

  @@index([cuentaPagarId, fecha])
}

enum EstadoTransferencia {
  BORRADOR

  APROBADA

  ANULADA
}

model Transferencia {
  id String @id @default(cuid())

  numero String

  fecha DateTime @default(now())

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  bodegaOrigenId String
  bodegaOrigen   Bodega @relation("BodegaOrigen", fields: [bodegaOrigenId], references: [id])

  bodegaDestinoId String
  bodegaDestino   Bodega @relation("BodegaDestino", fields: [bodegaDestinoId], references: [id])

  estado EstadoTransferencia @default(BORRADOR)

  observacion String?

  detalles TransferenciaDetalle[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, createdAt])
}

model TransferenciaDetalle {
  id String @id @default(cuid())

  transferenciaId String

  transferencia Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)

  productoId String

  producto Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  @@index([transferenciaId, productoId])
}

enum TipoDevolucion {
  COMPRA
  VENTA
}

enum EstadoDevolucion {
  BORRADOR
  APROBADA
  ANULADA
}

model Devolucion {
  id String @id @default(cuid())

  numero String

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  tipo TipoDevolucion

  estado EstadoDevolucion @default(BORRADOR)

  ventaId String?
  venta   Venta?  @relation(fields: [ventaId], references: [id])

  compraId String?
  compra   Compra? @relation(fields: [compraId], references: [id])

  bodegaId String
  bodega   Bodega @relation(fields: [bodegaId], references: [id])

  observacion String?

  detalles DevolucionDetalle[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, createdAt])
}

model DevolucionDetalle {
  id String @id @default(cuid())

  devolucionId String

  devolucion Devolucion @relation(fields: [devolucionId], references: [id], onDelete: Cascade)

  productoId String

  producto Producto @relation(fields: [productoId], references: [id])

  cantidad Int

  @@index([devolucionId, productoId])
}

enum EstadoGasto {
  PENDIENTE

  PAGADO

  ANULADO
}

model Gasto {
  id String @id @default(cuid())

  numero String

  fecha DateTime @default(now())

  concepto String

  descripcion String?

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  categoria String

  monto Decimal @db.Decimal(10, 2)

  estado EstadoGasto @default(PENDIENTE)

  metodoPago MetodoPago?

  referencia String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([empresaId, numero])
  @@index([empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, fecha])
}

enum TipoAuditoria {
  LOGIN

  LOGOUT

  CREATE

  UPDATE

  DELETE

  APROBAR

  ANULAR
}

model Auditoria {
  id String @id @default(cuid())

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  usuarioId String?
  usuario   Usuario? @relation(fields: [usuarioId], references: [id])

  modulo String

  accion TipoAuditoria

  descripcion String

  registroId String?

  ip String?

  userAgent String?

  createdAt DateTime @default(now())

  @@index([empresaId])
  @@index([usuarioId])
  @@index([modulo])
  @@index([createdAt])
  @@index([empresaId, modulo, createdAt])
  @@index([empresaId, accion, createdAt])
}

model Configuracion {
  id String @id @default(cuid())

  empresaId String @unique

  empresa Empresa @relation(fields: [empresaId], references: [id])

  //==========================
  // DATOS GENERALES
  //==========================

  logo String?

  moneda String @default("USD")

  simboloMoneda String @default("$")

  iva Decimal @default(15) @db.Decimal(5, 2)

  zonaHoraria String @default("America/Guayaquil")

  formatoFecha String @default("dd/MM/yyyy")

  idioma String @default("es")

  //==========================
  // NUMERACIÓN
  //==========================

  prefijoCompra String @default("COM")

  prefijoVenta String @default("VEN")

  prefijoCotizacion String @default("COT")

  prefijoFactura String @default("FAC")

  prefijoGasto String @default("GAS")

  prefijoTransferencia String @default("TRF")

  prefijoDevolucion String @default("DEV")

  //==========================
  // INVENTARIO
  //==========================

  permitirStockNegativo Boolean @default(false)

  controlarLotes Boolean @default(false)

  controlarSeries Boolean @default(false)

  actualizarCostoPromedio Boolean @default(true)

  //==========================
  // COMPRAS
  //==========================

  aprobarCompras Boolean @default(false)

  //==========================
  // VENTAS
  //==========================

  aprobarVentas Boolean @default(false)

  permitirDescuento Boolean @default(true)

  porcentajeMaxDescuento Decimal @default(20) @db.Decimal(5, 2)

  //==========================
  // SEGURIDAD
  //==========================

  dobleFactor Boolean @default(false)

  expiracionPassword Int @default(90)

  longitudMinimaPassword Int @default(8)

  intentosLogin Int @default(5)

  bloqueoMinutos Int @default(30)

  //==========================
  // AUDITORÍA
  //==========================

  auditoriaActiva Boolean @default(true)

  diasRetencionAuditoria Int @default(365)

  //==========================
  // NOTIFICACIONES
  //==========================

  enviarCorreo Boolean @default(true)

  enviarNotificaciones Boolean @default(true)

  //==========================
  // SISTEMA
  //==========================

  mantenimiento Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum TipoNotificacion {
  INFO

  WARNING

  ERROR

  SUCCESS
}

model Notificacion {
  id String @id @default(cuid())

  titulo String

  mensaje String

  tipo TipoNotificacion @default(INFO)

  leida Boolean @default(false)

  usuarioId String?

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@index([usuarioId, leida, createdAt])
}

model Permiso {
  id String @id @default(cuid())

  modulo String

  accion String

  nombre String

  descripcion String?

  estado Boolean @default(true)

  roles RolPermiso[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([modulo, accion])
}

model RolPermiso {
  id String @id @default(cuid())

  rolId String
  rol   Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade)

  permisoId String
  permiso   Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([rolId, permisoId])
  @@index([permisoId])
}

model Plan {
  id            String   @id @default(cuid())
  nombre        String   @unique
  codigo        String?  @unique
  descripcion   String?
  precioMensual Decimal
  precioAnual   Decimal?
  maxUsuarios   Int?
  maxSucursales Int?
  maxBodegas    Int?
  activo        Boolean  @default(true)

  suscripciones Suscripcion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Suscripcion {
  id String @id @default(cuid())

  empresaId String
  planId    String

  fechaInicio DateTime

  fechaFin DateTime?

  fechaRenovacion DateTime?

  estado EstadoSuscripcion

  tipoFacturacion TipoFacturacion

  precioMensual Decimal @db.Decimal(10, 2)

  precioAnual Decimal? @db.Decimal(10, 2)

  fechaCancelacion DateTime?

  motivoCancelacion String?

  observaciones String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  plan Plan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([empresaId])
  @@index([planId])
  @@index([estado])
  @@index([empresaId, estado])
  @@index([empresaId, fechaFin])
}

enum TipoFacturacion {
  MENSUAL
  ANUAL
}

enum EstadoSuscripcion {
  ACTIVA
  VENCIDA
  SUSPENDIDA
  CANCELADA
}
